# Copiar a .env en desarrollo local (sin Docker).
# Con Docker estas variables se inyectan desde docker-compose.

# sqlite:///./auditflow.db  (desarrollo sin Docker)
# postgresql+psycopg://user:pass@host:5432/dbname  (Docker / producción)
DATABASE_URL=sqlite:///./auditflow.db

SECRET_KEY=cambiar-en-produccion-por-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_EMAIL=admin@auditflow.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# JSON con los orígenes permitidos
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
