# ===== AuditFlow — variables de entorno (raíz, usadas por docker-compose) =====

# PostgreSQL
POSTGRES_USER=auditflow
POSTGRES_PASSWORD=auditflow_dev_password
POSTGRES_DB=auditflow

# API / seguridad
SECRET_KEY=cambiar-en-produccion-por-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primer administrador (se crea automáticamente al iniciar la API si no existe)
ADMIN_EMAIL=admin@auditflow.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# Orígenes CORS permitidos (JSON)
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Notificaciones por correo (Sprint 6; opcional en Sprint 0)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@auditflow.local
# SMTP_PASSWORD=
# SMTP_FROM=AuditFlow <notificaciones@auditflow.local>
