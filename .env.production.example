# Variables de entorno para PRODUCCIÓN (copiar a `.env` en el servidor o
# pegarlas en Dokploy → pestaña Environment del servicio).

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=auditflow
POSTGRES_PASSWORD=cambiar-esta-clave-por-una-fuerte
POSTGRES_DB=auditflow

# ── Aplicación ─────────────────────────────────────────────
ENVIRONMENT=production

# SECRET_KEY: generarla con:  openssl rand -hex 32
# La API NO arranca en producción si esta clave es la de ejemplo o < 32 caracteres.
SECRET_KEY=cambiar-con-openssl-rand-hex-32

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primer administrador (se crea al arrancar la API).
# ADMIN_PASSWORD NO puede ser "Admin123!" en producción.
ADMIN_EMAIL=tu.correo@dominio.com
ADMIN_PASSWORD=cambiar-tras-el-primer-login-1234
ADMIN_NAME=Administrador

# Orígenes permitidos (JSON). Con Docker/nginx el front y API comparten
# origen (nginx proxifica /api), pero se define por seguridad para
# navegadores y herramientas.
CORS_ORIGINS=["https://auditflow.tudominio.com"]
